{
    "schemaVersion": 1,
    "id": "dimensionviewer",
    "version": "${version}",
    "name": "Dimension Viewer",
    "description": "A mod that displays player dimensions in the tab list and chat",
    "authors": [
        "Ewan Selkirk"
    ],
    "contact": {
        "homepage": "https://github.com/Ewan-Selkirk/Dimension-Viewer",
        "sources": "https://github.com/Ewan-Selkirk/Dimension-Viewer"
    },
    "license": "MIT",
    "icon": "dimensionviewer.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "dev.stick_stack.dimensionviewer.DimensionViewerFabric"
        ],
        "client": [
            "dev.stick_stack.dimensionviewer.client.DimensionViewerClient"
        ]
    },
    "mixins": [
        "dimensionviewer.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.19.3",
        "fabric-api": "*",
        "minecraft": ">=26.1",
        "java": ">=21"
    },
    "suggests": {
        "modmenu": "*"
    }
}
